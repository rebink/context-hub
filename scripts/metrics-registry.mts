export const METRICS = Object.freeze(
  BASE_METRICS.map((item): MetricDefinition => {
    const parts = FORMULA_PARTS[item.id];
    const requirementSources = REQUIREMENT_SOURCE_BY_ID[item.id];
    if (!parts || !requirementSources)
      throw new Error(`missing canonical metric metadata: ${item.id}`);
    return Object.freeze({
      ...item,
      numerator: parts[0],
      denominator: parts[1],
      window: parts[2],
      dimensions: Object.freeze(
        item.dimensions.map((key) => Object.freeze({ key, values: METRIC_DIMENSION_VALUES[key] })),
      ),
      requirementSources: Object.freeze(requirementSources),
    });
  }),
);
