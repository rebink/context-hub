export const METRIC_STATUSES = [
  "MEASURED_LOCAL",
  "DERIVABLE",
  "BLOCKED_LIVE",
  "MANUAL_STUDY",
  "NOT_COLLECTED",
] as const;

export type MetricStatus = (typeof METRIC_STATUSES)[number];
export type MetricDimension = {
  key: keyof typeof METRIC_DIMENSION_VALUES;
  values: readonly string[];
};
export type MetricDefinition = {
  id: string;
  name: string;
  formula: string;
  numerator: string;
  denominator: string;
  unit: string;
  window: string;
  inclusion: string;
  exclusion: string;
  source: string;
  privacy: string;
  dimensions: readonly MetricDimension[];
  retention: string;
  collection: string;
  baseline: string;
  target: string;
  threshold: string;
  cadence: string;
  owner: string;
  status: MetricStatus;
  requirementSources: readonly string[];
};

type BaseMetric = Omit<
  MetricDefinition,
  "numerator" | "denominator" | "window" | "dimensions" | "requirementSources"
> & { dimensions: readonly (keyof typeof METRIC_DIMENSION_VALUES)[] };

export const METRIC_DIMENSION_VALUES = Object.freeze({
