  consumer_kind: ["HUMAN_HTTP", "MCP", "PI"],
  operation: ["SEARCH", "NODE", "NEIGHBORS", "CALLERS", "CALLEES", "PATH", "SOURCES"],
  window_days: ["7", "30", "90"],
  route_family: ["API", "ARTIFACT", "CONTEXT", "GRAPH", "MCP", "SYNC"],
  status_class: ["2XX", "3XX", "4XX", "5XX"],
  study_protocol: ["CONTEXT_RELEVANCE_V1", "CONNECT_V1", "ONBOARD_V1", "MANUAL_PASTE_V1"],
  operation_class: ["READ", "WRITE", "QUERY"],
  object_class: ["ARTIFACT", "GRAPH", "SNAPSHOT", "ORPHAN"],
  workflow: ["CI", "GRAPHIFY"],
  cache_state: ["HIT", "MISS", "UNKNOWN"],
